  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "IM", "Music", "Reader", "Nav", "ScrollOpt"
      ],
      "import": "_ELP.json"
    },
    {
      "friendly": "白名单",
      "packages": [
        "com.termux",
        "xyz.chatboxapp.chatbox",
        "com.danemadsen.maid",
        "com.freakurl.apps.ollama",
        "io.github.xororz.localdream"
      ],
      "import": "_WhiteList.json"
    },
    {
      "friendly": "ShortVideo",
      "packages": ["ShortVideo"],
      "import": "_ShortVideo.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}