{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "max_cpus_cpu5": "/sys/devices/system/cpu/cpu5/core_ctl/max_cpus",
    "min_cpus_cpu5": "/sys/devices/system/cpu/cpu5/core_ctl/min_cpus",
    "core_ctl_5": "/sys/devices/system/cpu/cpu5/core_ctl/enable",
    "max_cpus_cpu2": "/sys/devices/system/cpu/cpu2/core_ctl/max_cpus",
    "min_cpus_cpu2": "/sys/devices/system/cpu/cpu2/core_ctl/min_cpus",
    "core_ctl_2": "/sys/devices/system/cpu/cpu2/core_ctl/enable",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "cpu_min_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq",
    "cpu_max_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq",
    "sched_boost": "/proc/sys/walt/sched_boost",
    "sched_upmigrate": "/proc/sys/walt/sched_upmigrate",
    "sched_downmigrate": "/proc/sys/walt/sched_downmigrate"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 1459200, "min": 672000, "margins": "120" },
            { "max": 1612800, "min": 960000, "margins": "150 1401600:120", "mt": 33 },
            { "max": 1497600, "min": 960000, "margins": "150 1286400:120", "mt": 50 },
            { "max": 1363200, "min": 787200, "margins": "150 1132800:120" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1689600, "min": 787200, "margins": "120" },
            { "max": 1824000, "min": 960000, "margins": "200 1612800:120", "mt": 30 },
            { "max": 1708800, "min": 960000, "margins": "200 1497600:120", "mt": 50 },
            { "max": 1593600, "min": 787200, "margins": "200 1363200:120" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1689600, "min": 1017600, "margins": "150" },
            { "max": 2438400, "min": 1920000, "margins": "200" },
            { "max": 2380800, "min": 1920000, "margins": "200" },
            { "max": 2438400, "min": 1939200, "margins": "200" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1804800, "min": 1017600, "margins": "150" },
            { "max": 3148800, "min": 2438400, "margins": "300" },
            { "max": 2956800, "min": 2438400, "margins": "300" },
            { "max": 3052800, "min": 2380800, "margins": "300" }
          ]
        },
        "inactive": {
          "core_ctl": [3],
          "cpus": [
            { "max": 1459200, "min": 672000, "margins": "100" },
            { "max": 1612800, "min": 614400, "margins": "120", "mt": 35 },
            { "max": 1497600, "min": 614400, "margins": "120", "mt": 50 },
            { "max": 1363200, "min": 576000, "margins": "120" }
          ]
        },
        "idle": {
          "core_ctl": [3],
          "cpus": [
            { "max": 1248000, "min": 556800, "margins": "100" },
            { "max": 1401600, "min": 614400, "margins": "100", "mt": 40 },
            { "max": 1286400, "min": 614400, "margins": "100", "mt": 50 },
            { "max": 1132800, "min": 576000, "margins": "100" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
      ],
      "exit": [
        ["$sched_boost", "0"]
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["@governor", "walt", "schedutil"],
    ["/sys/devices/system/cpu/cpu0/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu1/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu2/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu3/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu4/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu5/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu6/cpufreq/walt/rtg_boost_freq", "0"],
    ["/sys/devices/system/cpu/cpu7/cpufreq/walt/rtg_boost_freq", "0"],
    ["@preset", "limiter_off"],
    ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "364800"],
    ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "547000"]
  ],
  "presets": { 
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy2/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy2/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy5/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy5/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "target_loads": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/target_loads"],
      ["/sys/devices/system/cpu/cpufreq/policy2/walt/target_loads"],
      ["/sys/devices/system/cpu/cpufreq/policy5/walt/target_loads"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/target_loads"]
    ],   
    "memlat": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/decay_rate", "90"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/window_ms", "40"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/sample_ms", "4"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "307200", "499200", "499200", "480000"],
      ["$sched_boost", "0"],
      ["@values", "latency", "0", "4000", "0", "4000", "0", "4000", "0", "4000"]
    ],
    "common_app": [
      ["@cpuset", "0-1", "0-6", "0-6", "0-7"],
      ["/dev/cpuset/sf/cpus", "#2-7"],
      ["@hispeed_load", "90", "90", "90", "90"],
      ["@values", "latency", "0", "2000", "0", "2000", "0", "2000", "0", "2000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "0"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "#2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc/max_freq", "806000"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq","1555200"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq","1555200"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq","1555200"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/max_freq","1555200"],
      ["$mod_percent", "105"],
      ["/sys/block/zram0/hybridswap_swapd_pause", "1"],
      ["$sched_assist", "1"],
      ["@gpu_freq_min", "0MHz"]
    ],
    "common_gaming": [
      ["@hispeed_freq", "0", "0", "0", "0"],
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@gesture", "PAUSE"],
      ["@cpuset", "0-1", "0-1", "2-6", "2-7"],
      ["/dev/cpuset/sf/cpus", "#2-6"],
      ["@hispeed_load", "90", "90", "90", "90"],
      ["@values", "latency", "2000", "2000", "2000", "2000", "2000", "2000", "2000", "2000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq","2035200"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq","2035200"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq","2035200"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/max_freq","2035200"],
      ["/sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc/max_freq", "1066000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "1"],
      ["$mod_percent", "96"],
      ["/sys/block/zram0/hybridswap_swapd_pause", "0"]
    ],

    "powersave_active": [
