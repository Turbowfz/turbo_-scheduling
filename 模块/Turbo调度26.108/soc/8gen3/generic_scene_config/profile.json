        ["@values", "latency", "2000", "1000", "2000", "1000", "2000", "1000", "2000", "1000"]
      ]
    },
    "pedestal": {
      "call": [
        ["@preset", "memlat"],
        ["/sys/devices/system/cpu/bus_dcvs/LLCC/boost_freq", "806000"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "1555200"],
        ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "2736000"],
        ["@gpu_freq_max", "1100MHz"],
        ["@limiter", "NONE"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "#1804800", "#3148800", "#2956800", "#3187200"],
        ["@preset", "fast_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "latency", "2000", "0", "2000", "0", "2000", "0", "2000", "0"]
      ]
