  "schemes": {
    "powersave": {
      "call": [
        ["/sys/devices/system/cpu/cpufreq/boost", "0"],
        ["@gpu_freq_max", "700MHz"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "powersave_active"],
        ["@cpu_freqs_max", "1670400", "#2131200", "#2131200", "#2246400"]
      ],
    "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "balance": {
      "call": [
        ["@gpu_freq_max", "800MHz"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "balance_active"],
        ["@cpu_freqs_max", "1804800", "#2438400", "#2438400", "#2630400"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "performance": {
