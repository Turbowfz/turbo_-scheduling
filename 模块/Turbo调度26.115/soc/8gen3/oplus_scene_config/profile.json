            { "max": 1132800, "min": 576000, "margins": "100" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
      ],
      "exit": [
        ["$sched_boost", "0"]
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["@preset", "limiter_on"],
    ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "364800"],
    ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "547000"]
