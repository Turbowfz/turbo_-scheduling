          "cpus": [
            { "max": 1459200, "min": 672000, "margins": "100" },
            { "max": 1612800, "min": 614400, "margins": "120", "mt": 35 },
            { "max": 1497600, "min": 614400, "margins": "120", "mt": 50 },
            { "max": 1363200, "min": 576000, "margins": "120" }
          ]
        },
        "idle": {
